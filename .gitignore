# AniShelf365 gitignore

# Private user data
data/
token.json
config.json
library.db
*.log

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
ENV/
env/
.env
.env.*

# PyInstaller
*.spec
!anishelf365.spec

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Local tests (only in project root, NOT in tests/ folder)
/test_*.py
/*_test.py

# But always include tests/ folder
!tests/
!tests/**

# ---------- Pytest ----------
.pytest_cache/
.coverage
htmlcov/
coverage.xml
# Never track pycache inside tests (overrides !tests/**)
tests/__pycache__/

# Personal notes
BUGS.md

# Release archives
/AniShelf365-*.zip
